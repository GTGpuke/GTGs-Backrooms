<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Conventions du projet (docs/dev/CONTRIBUER.md), celles qu'un outil peut verifier :
  sources ASCII, imports ordonnes sans wildcard ni doublon, journal via ModConstants.LOGGER,
  Javadoc sur chaque type public, classes utilitaires finales au constructeur prive, mise en forme.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
    </module>

    <module name="NewlineAtEndOfFile"/>
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="[^\x00-\x7F]"/>
        <property name="message" value="Caractere non ASCII : les sources restent en ASCII (accents dans la doc, pas dans le code)."/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="System\.(out|err)\.print|printStackTrace\("/>
        <property name="message" value="Journal via ModConstants.LOGGER uniquement."/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="LoggerFactory\.getLogger|LogManager\.getLogger"/>
        <property name="message" value="Un seul logger : ModConstants.LOGGER."/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Espaces en fin de ligne."/>
    </module>
    <module name="LineLength">
        <property name="max" value="180"/>
        <property name="ignorePattern" value="^import |^package |https?://"/>
    </module>

    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="ImportOrder">
            <property name="groups" value="java,javax,/^(com\.(mojang|google|sun|llamalad7)|org|it|io)\./,net.minecraft,net.fabricmc,com.gtgpuke"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="true"/>
            <property name="option" value="top"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
        </module>

        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
        </module>
        <module name="HideUtilityClassConstructor"/>
        <module name="FinalClass"/>
        <module name="OneTopLevelClass"/>
        <module name="OuterTypeFilename"/>

        <module name="ModifierOrder"/>
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
        </module>
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>
        <module name="TypecastParenPad"/>
    </module>
</module>
